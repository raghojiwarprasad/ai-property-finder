# Copy to .env.local. Every value is optional for local development.

# Model provider. Leave unset to run in the labelled development fixture mode.
# When set, the model gateway uses the Anthropic SDK. Never expose this to the browser.
# ANTHROPIC_API_KEY=
# AI_MODE=live            # "fixture" (default when no key) or "live"
# AI_MODEL=claude-opus-5

# Database. Leave unset to use an embedded PGlite database stored in ./data/pglite.
# Set a PostgreSQL connection string to use a server database instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/learn_ai

# Cookie signing secret for guest and account sessions. A random value is generated
# in development if unset; set a stable value for any shared deployment.
# SESSION_SECRET=

# Retention defaults (hours / days), see spec/prds/10_profile_privacy_and_accounts.md
# RAW_UPLOAD_RETENTION_HOURS=24
# GUEST_RETENTION_DAYS=7
